<?xml version="1.0" encoding="utf-8"?>
<!-- 功能页：功能宫格，Kotlin 动态填充 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="18dp"
        android:paddingBottom="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="功能"
            android:textColor="@color/neo_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:text="愿你始终保持好奇心，也始终拥有选择的自由"
            android:textColor="@color/neo_text_hint"
            android:textSize="12sp" />

        <!-- 搜索框 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/neu_card_pressed"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="14dp"
            android:paddingVertical="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_search" />

            <EditText
                android:id="@+id/neo_feature_search_input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@null"
                android:hint="搜索功能"
                android:inputType="text"
                android:maxLines="1"
                android:padding="0dp"
                android:textColor="@color/neo_text_primary"
                android:textColorHint="@color/neo_text_hint"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- 功能条目容器（Kotlin 动态填充） -->
        <LinearLayout
            android:id="@+id/neo_feature_grid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
