<?xml version="1.0" encoding="utf-8"?>
<!-- 单删好友二级页：顶栏(返回+全选/反选) + 搜索栏 + 统计 + 勾选列表 + 底部删除主按钮 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/neo_base"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <!-- 顶栏：返回按钮 + 标题 + 全选/反选 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:id="@+id/neo_fm_back"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/neu_logo_slot"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_neo_back" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:text="单删好友"
            android:textColor="@color/neo_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/neo_fm_select_all"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="全选"
            android:textColor="@color/neo_primary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/neo_fm_invert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:text="反选"
            android:textColor="@color/neo_primary"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 搜索栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/neu_input_bg"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_neo_search"
            android:tint="@color/neo_text_hint" />

        <EditText
            android:id="@+id/neo_fm_search_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="搜索好友"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:textColor="@color/neo_text_primary"
            android:textColorHint="@color/neo_text_hint"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 统计信息 -->
    <TextView
        android:id="@+id/neo_fm_summary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="10dp"
        android:paddingBottom="4dp"
        android:textColor="@color/neo_text_hint"
        android:textSize="12sp" />

    <!-- 勾选列表 -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/neo_fm_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp" />
    </ScrollView>

    <!-- 底部删除按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="24dp">

        <Button
            android:id="@+id/neo_fm_delete_btn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/neu_button_primary"
            android:stateListAnimator="@null"
            android:text="删除已选"
            android:textColor="@color/neo_on_primary"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
